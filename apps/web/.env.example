# Frontend Push Notifications Configuration

# VAPID Public Key for Web Push Notifications
# Generate keys at: https://web-push-codelab.glitch.me/
# Keep the private key secure on your backend!
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# PocketBase URL (should match your backend)
VITE_POCKETBASE_URL=http://localhost:8090

# Push notification settings
# Set to true if you want to require notifications
VITE_NOTIFICATIONS_OPTIONAL=true
